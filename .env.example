# Environment for the backend. Put these in a root .env file (auto-loaded) or set them in your shell / IDE run config.
# Every value has a dev default, so for local development you only need the database ones if yours differ.

# --- Database (MongoDB Atlas, or any MongoDB replica set) ---
# Default without MONGO_URI: mongodb://localhost:27017/applyflow
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# ApplyFlow only uses this database (it overrides any database named in the URI).
MONGO_DATABASE=applyflow

# --- Secrets (REQUIRED to change for real use) ---
# Encrypts stored IMAP app passwords (AES-256-GCM, key derived via SHA-256).
# If you change it later, previously saved app passwords can no longer be decrypted — reconnect accounts.
# Generate one with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# --- Admin login (created/updated from these on every start; owns pre-multi-user data) ---
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_DISPLAY_NAME=Abhinay

# --- Behaviour ---
# Self-service sign-up (POST /api/auth/register). false = only existing accounts can sign in.
REGISTRATION_ENABLED=true
# Seed demo applications/emails on first start (only when there are no applications yet).
SEED_DATA=true
# Background IMAP sync scheduler.
SYNC_ENABLED=true
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
